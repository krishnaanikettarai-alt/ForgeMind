# Backend-only NVIDIA NIM credentials. Copy this file to .env and keep the key secret.
NVIDIA_API_KEY=
FORGEMIND_NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Optional for a self-hosted NIM endpoint; defaults to NVIDIA's hosted API.
# FORGEMIND_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Frontend API URL. Vite exposes only VITE_-prefixed values to browser code.
VITE_AGENT_API_URL=http://127.0.0.1:8000
